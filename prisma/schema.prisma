
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Lead {
  id           Int      @id @default(autoincrement())
  name         String
  email        String
  phone        String
  businessType String
  message      String
  status       String   @default("New")
  autoReply    String
  createdAt    DateTime @default(now())
}